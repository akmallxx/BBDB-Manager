# GEMINI_API_KEY: Required for Gemini AI API calls (if AI features are enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================
# Web & Core Application Settings
# ==============================================================
VITE_APP_NAME="BBDB Manager"
APP_NAME="BBDB Manager"
PORT=39000

# ==============================================================
# Tauri Desktop Application Configuration
# (Seluruh konfigurasi Tauri dipusatkan di sini)
# ==============================================================
# Nama aplikasi desktop & ID bundle
TAURI_PRODUCT_NAME="BBDB Manager"
TAURI_IDENTIFIER="com.bbdb.manager"
TAURI_VERSION="1.0.0"

# Pengaturan Jendela Desktop
TAURI_WINDOW_TITLE="BBDB Manager"
TAURI_WINDOW_WIDTH=1280
TAURI_WINDOW_HEIGHT=820
TAURI_WINDOW_MIN_WIDTH=900
TAURI_WINDOW_MIN_HEIGHT=600
TAURI_WINDOW_RESIZABLE=true
TAURI_WINDOW_FULLSCREEN=false
TAURI_WINDOW_CENTER=true
TAURI_WINDOW_DECORATIONS=true

# Development & Build Commands (Opsional, bawaan: devUrl mengikuti PORT)
# TAURI_DEV_URL="http://localhost:3000"
# TAURI_BEFORE_DEV_COMMAND="bun run dev"
# TAURI_BEFORE_BUILD_COMMAND="bun run build"
