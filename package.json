{
  "name": "bbdb-manager",
  "description": "BBDB Manager - Modern Beekeeper-like Database Studio",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "bun": "bun run server.ts",
    "build": "vite build",
    "build:server": "tsx scripts/build-server.ts",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "tauri:sync": "tsx scripts/sync-tauri-config.ts",
    "tauri": "tsx scripts/sync-tauri-config.ts && export PATH=\"$HOME/.cargo/bin:$PATH\" && tauri",
    "desktop:dev": "tsx scripts/sync-tauri-config.ts && export PATH=\"$HOME/.cargo/bin:$PATH\" && tauri dev",
    "desktop:build": "tsx scripts/sync-tauri-config.ts && tsx scripts/build-server.ts && export PATH=\"$HOME/.cargo/bin:$PATH\" && tauri build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mssql": "^12.3.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mssql": "^12.7.6",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/cli": "^2.12.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
